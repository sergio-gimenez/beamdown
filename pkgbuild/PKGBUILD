pkgname=beamdown
pkgver=0.6.0
pkgrel=1
pkgdesc='PowerPoint + LaTeX Beamer, but Markdown-driven, for the agentic era (a fork of Hype)'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base>=6.9' 'qt6-declarative>=6.9' 'qt6-multimedia>=6.9' 'qt6-imageformats' 'qt6-svg' 'ffmpeg' 'source-highlight' 'zlib' 'libwebp' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() {
  cd "$startdir/.."
  ./bin/build
}
package() {
  cd "$startdir/.."
  install -Dm755 build/beamdown "$pkgdir/usr/bin/beamdown"
  install -Dm644 pkgbuild/io.github.sergio_gimenez.Beamdown.desktop "$pkgdir/usr/share/applications/io.github.sergio_gimenez.Beamdown.desktop"
  install -Dm644 pkgbuild/beamdown.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.sergio_gimenez.Beamdown.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/beamdown/LICENSE"
}
